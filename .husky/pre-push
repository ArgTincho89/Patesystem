# Source changes run the fast changed-files gate.
# Test-only and frontend/config changes run the full suite so coverage
# thresholds are measured against all source files. If the diff cannot be
# computed, fall back to the full suite.
changed=$(git diff --name-only origin/master...HEAD 2>/dev/null)

if printf '%s\n' "$changed" | grep -qE '^src/'; then
  npm run test:coverage:diff
else
  npm run test:coverage
fi
